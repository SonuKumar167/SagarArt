RewriteEngine On
RewriteBase /

# Serve real files and folders directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# Slug pages
RewriteRule ^page/([^/]+)/?$ page.php?slug=$1 [END,NC,QSA]
RewriteRule ^service/([^/]+)/?$ service.php?slug=$1 [END,NC,QSA]

# Static pages
RewriteRule ^reviews/?$ reviews.php [END,NC,QSA]
RewriteRule ^admin/login/?$ admin/login.php [END,NC,QSA]
RewriteRule ^about/?$ index.php?route=about [END,QSA]
RewriteRule ^contact/?$ index.php?route=contact [END,QSA]
RewriteRule ^services/?$ index.php?route=services [END,QSA]

# Fallback
RewriteRule ^(.+)$ index.php?route=$1 [END,QSA]